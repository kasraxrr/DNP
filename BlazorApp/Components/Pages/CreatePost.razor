@page "/CreatePost"
@inject IPostService postService
@inject NavigationManager navMgr

<PageTitle>New post</PageTitle>

<div class="page-wrap">
    <div class="page-header">
        <h1>New post</h1>
        <p>Share something with the forum.</p>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="panel">
                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="alert-msg error">@message</div>
                }

                <div class="field">
                    <label>Title</label>
                    <input type="text" @bind="title" placeholder="Give your post a title"/>
                </div>

                <div class="field">
                    <label>Body</label>
                    <textarea @bind="body" placeholder="Write your post here..."></textarea>
                </div>

                <button class="btn-main" @onclick="Create" disabled="@isSaving">
                    @(isSaving ? "Publishing..." : "Publish post")
                </button>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="panel empty-state">
                <p>You'll have to log in to write a post.</p>
                <a href="login" class="btn-main">Log in</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    // Given to us by <CascadingAuthenticationState> in Routes.razor
    [CascadingParameter] public Task<AuthenticationState> AuthState { get; set; } = null!;

    private string title = string.Empty;
    private string body = string.Empty;
    private string message = string.Empty;
    private bool isSaving;

    private async Task Create()
    {
        message = string.Empty;

        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(body))
        {
            message = "Please fill in both title and body.";
            return;
        }

        isSaving = true;
        try
        {
            int? userId = await AuthState.GetUserIdAsync();
            if (userId is null)
            {
                message = "You must be logged in to write a post.";
                isSaving = false;
                return;
            }

            // The logged-in user is the author
            CreatePostDto dto = new() { Title = title, Body = body, UserId = userId.Value };
            PostDto created = await postService.AddPostAsync(dto);

            navMgr.NavigateTo($"/ViewPost/{created.Id}");
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            message = e.Message;
        }
        isSaving = false;
    }
}
